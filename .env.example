# GEMINI_API_KEY: Server-side Gemini API key for AI-assisted features (optional - system includes built-in fallbacks)
# AI Studio automatically injects this at runtime from user secrets if configured.
GEMINI_API_KEY=""

# APP_URL: The hosting URL (automatically injected by AI Studio Cloud Run environment)
APP_URL=""

# Supabase Production Database & Auth Integration (configured via client .env)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
